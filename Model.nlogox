  <linkShapes>
    <shape name="default" curviness="0.0">
      <lines>
        <line x="-0.2" visible="false">
          <dash value="0.0"></dash>
          <dash value="1.0"></dash>
        </line>
        <line x="0.0" visible="true">
          <dash value="1.0"></dash>
          <dash value="0.0"></dash>
        </line>
        <line x="0.2" visible="false">
          <dash value="0.0"></dash>
          <dash value="1.0"></dash>
        </line>
      </lines>
      <indicator>
        <shape name="link direction" rotatable="true" editableColorIndex="0">
          <line endX="90" startY="150" marked="true" color="-1920102913" endY="180" startX="150"></line>
          <line endX="210" startY="150" marked="true" color="-1920102913" endY="180" startX="150"></line>
        </shape>
      </indicator>
    </shape>
  </linkShapes>
  <previewCommands>setup repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="experiment 2 - efectul influencerilor" repetitions="30" sequentialRunOrder="true" runMetricsEveryStep="true">
      <setup>setup 
repeat 198 [create-network] 
calculate-influencers 
set-initial-adopters</setup>
      <go>go</go>
      <exitCondition><![CDATA[new-adopters-this-tick = 0 and ticks > 5]]></exitCondition>
      <metrics>
        <metric>count turtles with [state = "adopted"] / count turtles * 100</metric>
        <metric>group-adoption-variance</metric>
        <metric>avg-openness-adopted</metric>
        <metric>avg-risk-adopted</metric>
        <metric>avg-price-adopted</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="homophily">
          <value value="0.5"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="number-of-groups">
          <value value="3"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="use-influencers?">
          <value value="true"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="initial-adopters">
          <value value="5"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="peer-effect">
          <value value="0.3"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="product-price">
          <value value="0.7"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="influencer-effect" first="0.3" step="0.3" last="1"></steppedValueSet>
      </constants>
    </experiment>
    <experiment name="experiment 3- homofilie" repetitions="30" sequentialRunOrder="true" runMetricsEveryStep="true">
      <setup>setup 
repeat 198 [create-network] 
calculate-influencers 
set-initial-adopters</setup>
      <go>go</go>
      <exitCondition><![CDATA[new-adopters-this-tick = 0 and ticks > 20]]></exitCondition>
      <metrics>
        <metric>count turtles with [state = "adopted"] / count turtles * 100</metric>
        <metric>safe-group-variance</metric>
        <metric>avg-openness-adopted</metric>
        <metric>avg-risk-adopted</metric>
        <metric>avg-price-adopted</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="peer-effect">
          <value value="0.75"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="use-influencers?">
          <value value="false"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="product-price">
          <value value="0.35"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="initial-adopters">
          <value value="5"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="number-of-groups">
          <value value="3"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="homophily" first="0.2" step="0.35" last="0.9"></steppedValueSet>
        <enumeratedValueSet variable="influencer-effect">
          <value value="0.7"></value>
        </enumeratedValueSet>
      </constants>
    </experiment>
    <experiment name="experiment 4 - variatia grupurilor" repetitions="30" sequentialRunOrder="true" runMetricsEveryStep="true" timeLimit="200">
      <setup>setup 
repeat 198 [ create-network ] 
calculate-influencers 
set-initial-adopters</setup>
      <go>go</go>
      <exitCondition>not any? turtles with [state = "unaware" or state = "aware"]</exitCondition>
      <metrics>
        <metric>count turtles with [state = "adopted"] / count turtles * 100</metric>
        <metric>tick-25-adoption</metric>
        <metric>tick-50-adoption</metric>
        <metric>tick-75-adoption</metric>
        <metric>avg-openness-adopted</metric>
        <metric>avg-risk-adopted</metric>
        <metric>safe-group-variance</metric>
        <metric>avg-openness-non-adopted</metric>
        <metric>avg-risk-non-adopted</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="peer-effect">
          <value value="0.7"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="use-influencers?">
          <value value="true"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="product-price">
          <value value="0.75"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="initial-adopters">
          <value value="5"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="number-of-groups">
          <value value="3"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="homophily">
          <value value="0.85"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="influencer-effect">
          <value value="0.8"></value>
        </enumeratedValueSet>
      </constants>
    </experiment>
  </experiments>
</model>
