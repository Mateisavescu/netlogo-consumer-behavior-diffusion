<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="false">
  <code><![CDATA[globals [
new-adopters-this-tick
  tick-25-adoption
tick-50-adoption
tick-75-adoption
  group-adoption-variance
]
turtles-own [state
  susceptibility
  influencer?
  aware-time
  group-id
  threshold
  awareness-source
  adoption-intent

  seed-influencer?
  adoption-source
  intent-decay
  novelty-sensitivity
  price-sensitivity
  risk-aversion
  openness
]
undirected-link-breed [consumer-links consumer-link]
directed-link-breed [influence-links influence-link]
consumer-links-own [current-flow active? ]
influence-links-own [current-flow active? ]


to setup
  clear-all
  set-default-shape turtles "person"

  ;; primul nod
  make-node-with-group nobody random number-of-groups

  ;; al doilea nod, conectat la primul
  make-node-with-group turtle 0 random number-of-groups
ask turtle 0 [
  setxy -3 + random 2 0
]

ask turtle 1 [
  setxy 3 + random 2 0
]
  resize-nodes
  update-nodes
  ask turtles [
  set awareness-source "none"
  set adoption-source "none"
    set intent-decay -1
]
  setup-group-pens
set new-adopters-this-tick 0
  set tick-25-adoption 0
set tick-50-adoption 0
set tick-75-adoption 0
set group-adoption-variance 0

  reset-ticks
end

to reset-information
  ask turtles [
    set state "unaware"
    set adoption-intent 0
    set aware-time -1
    set awareness-source "none"
    set adoption-source "none"
    set seed-influencer? false
    set intent-decay -1
     ;; openness, susceptibility, threshold raman neschimbate la reset
    ;; sunt trasaturi de personalitate, nu stari
  ]

    ask (link-set consumer-links ) [
    set active? false
    set color gray
    set current-flow 0
  ]
    ask (link-set influence-links) [
    set active? false
    set color violet
    set current-flow 0
  ]

clear-all-plots
  setup-group-pens
  set new-adopters-this-tick 0
  set tick-25-adoption 0
set tick-50-adoption 0
set tick-75-adoption 0
  set group-adoption-variance 0
  resize-nodes
  update-nodes
  reset-ticks
end
to-report find-partner-by-group [new-group]
  let candidate-turtles no-turtles

  ifelse random-float 1 < homophily [
    set candidate-turtles turtles with [group-id = new-group]
  ] [
    set candidate-turtles turtles with [group-id != new-group]
  ]

  ;; fallback dacă setul ales e gol
  if not any? candidate-turtles [
    set candidate-turtles turtles
  ]

  if not any? candidate-turtles [
    report nobody
  ]

  report preferentially-select-partner candidate-turtles
end

to-report preferentially-select-partner [candidate-turtles]
  ;; 20% alegere random pentru a reduce efectul de hub extrem
  if random-float 1 < 0.2 [
    report one-of candidate-turtles
  ]

  let candidate-links consumer-links with [
    member? end1 candidate-turtles or member? end2 candidate-turtles
  ]

  if any? candidate-links [
    let chosen-link one-of candidate-links
    let possible-ends [both-ends] of chosen-link
    let valid-ends possible-ends with [member? self candidate-turtles]

    if any? valid-ends [
      report one-of valid-ends
    ]
  ]

  report one-of candidate-turtles
end

to create-network
  ask (link-set consumer-links influence-links)
   [
    set color grey
    set active? false
    set current-flow 0
  ]

   let new-group random number-of-groups
  let partner find-partner-by-group new-group
  make-node-with-group partner new-group

  resize-nodes
  update-nodes



  layout
 tick
  
end

to go
   
   

  
  diffusion
  let current-adoption-pct 100 * count turtles with [state = "adopted"] / count turtles

if tick-25-adoption = 0 and current-adoption-pct >= 25 [
  set tick-25-adoption ticks
]
if tick-50-adoption = 0 and current-adoption-pct >= 50 [
  set tick-50-adoption ticks
]
if tick-75-adoption = 0 and current-adoption-pct >= 75 [
  set tick-75-adoption ticks
]
  let group-rates []
let g 0
while [g < number-of-groups] [
  let total-group count turtles with [group-id = g]
  if total-group > 0 [
    set group-rates lput (100 * count turtles with [group-id = g and state = "adopted"] / total-group) group-rates
  ]
  set g g + 1
]
if length group-rates > 0 [
  set group-adoption-variance variance group-rates
]
 update-nodes

  update-influence-plot
  update-my-plots
  update-group-adoption-plot

  update-adoption-source-plot
  
  update-adoption-speed-plot





  tick
  display
end



to make-node-with-group [old-node new-group]
  create-turtles 1 [
    set state "unaware"
    set influencer? false
    set seed-influencer? false
    set shape "person"
    set color white
    set aware-time -1
    set adoption-intent 0

    set group-id new-group
    set intent-decay -1
    set novelty-sensitivity random-float 1
    set price-sensitivity random-float 1
    set risk-aversion random-float 1
    ;; 0 = foarte sceptic/rezistent, 1 = foarte deschis/receptiv
    set openness random-float 1
    set susceptibility openness  ;; pastram pentru compatibilitate cu restul codului
    set threshold 1 - openness   ;; threshold e opusul deschiderii


let angle (360 / number-of-groups) * new-group
let radius 8

setxy
  (radius * cos angle + random-float 2 - 1)
  (radius * sin angle + random-float 2 - 1)


    if old-node != nobody [
      move-to old-node
       rt random 360
       fd 1

      create-consumer-link-with old-node [
        set color gray
        set active? false
        set current-flow 0

      ]
    ]
  ]
end

to calculate-influencers
  update-influencers
  transform-links
  resize-nodes
  update-nodes


end

to resize-nodes
  ask turtles [
    let total-neighbors (turtle-set consumer-link-neighbors in-influence-link-neighbors out-influence-link-neighbors)
    set size max (list 1 sqrt (count total-neighbors + 1))
  ]
end

to update-influencers
  ask turtles [
    set influencer? false
  ]

  let avg-degree mean [count link-neighbors] of turtles
  let sd-degree standard-deviation [count link-neighbors] of turtles

  ask turtles with [count link-neighbors > avg-degree + 1 * sd-degree] [
    set influencer? true
  ]
end

to update-nodes


  ask turtles [
    if influencer? [
      set shape "star"
      if state = "adopted" [
        set color red
      ]
      if state != "adopted" [
        set color orange
      ]
    ]

    if not influencer? [
      set shape "person"
      if state = "unaware" [
  set color white
]

if state = "aware" [
  set color blue
]

if state = "adopted" [
  set color brown
]

    ]
  ]
end




to-report limit-magnitude [number limit]
  if number > limit [ report limit ]
  if number < (- limit) [ report (- limit) ]
  report number
end

to layout
  repeat 10 [
    let factor sqrt count turtles
    let intra-links consumer-links  with [
  [group-id] of end1 = [group-id] of end2
]

let inter-links consumer-links with [
  [group-id] of end1 != [group-id] of end2
]
    layout-spring turtles intra-links 0.4 4 2
layout-spring turtles inter-links 0.05 12 1
    display
  ]

  let x-offset max [xcor] of turtles + min [xcor] of turtles
  let y-offset max [ycor] of turtles + min [ycor] of turtles

  set x-offset limit-magnitude x-offset 0.1
  set y-offset limit-magnitude y-offset 0.1

ask turtles [
  setxy (xcor - x-offset / 2) (ycor - y-offset / 2)
]
end

to diffusion
    let adopters-before count turtles with [state = "adopted"]
  ask turtles with [not influencer?] [

    ;; definim vecinii
    let peer-neighbors consumer-link-neighbors
    let influencer-neighbors in-influence-link-neighbors

;; UNAWARE->AWARE

    if state = "unaware" [

      let peer-share 0
      if any? peer-neighbors [
        set peer-share
          count (peer-neighbors with [state = "aware" or state = "adopted"]) / count peer-neighbors
      ]

      let influencer-share 0
      if use-influencers? and any? influencer-neighbors [
        set influencer-share
          count (influencer-neighbors with [state = "adopted" or state = "aware"]) / count influencer-neighbors
      ]

      let p-aware 0.005 + 0.12 * peer-share * peer-effect + influencer-effect * 0.16 * influencer-share + 0.06 * susceptibility
      set p-aware min (list 1 p-aware)

      if random-float 1 < p-aware [
        set state "aware"
        set aware-time ticks

 ifelse peer-share = 0 and influencer-share = 0 [
  set awareness-source "external"
][
  ifelse abs (peer-share - influencer-share) < 0.1 [
    set awareness-source "mixed"
  ][
    ifelse peer-share > influencer-share
      [ set awareness-source "peer" ]
      [ set awareness-source "influencer" ]
  ]
]
      ]
    ]


;;AWARE->ADOPTED

    ;;CALCULAM SOCIAL SHARE
    if state = "aware" and ticks > aware-time [


      let social-share 0
      if any? peer-neighbors [
        set social-share
          count (peer-neighbors with [state = "adopted"]) / count peer-neighbors
      ]
      ;;TRANSITIVITY
      let same-group-adopted-peers peer-neighbors with [state = "adopted"
        and group-id = [group-id] of myself ]

let transitivity-bonus 0
if count same-group-adopted-peers >= 2 [
  let peer-peer-links count consumer-links with [
    member? end1 same-group-adopted-peers and member? end2 same-group-adopted-peers
  ]

  let max-possible-links (count same-group-adopted-peers * (count same-group-adopted-peers - 1)) / 2

  if max-possible-links > 0 [
    set transitivity-bonus peer-peer-links / max-possible-links
  ]
]
;;CALCULAM INFLUENCER-SHARE
      let influencer-share 0
      if use-influencers? and any? influencer-neighbors [
        set influencer-share
          count (influencer-neighbors with [state = "adopted"]) / count influencer-neighbors
      ]
    if ticks - aware-time > 1 [
  ;; boost mic dacă tocmai a existat un semnal social recent
  if intent-decay >= 0 and ticks - intent-decay = 1 [
    set adoption-intent adoption-intent + 0.05
  ]

  ;; dacă nu a mai existat niciun impuls recent, începe scăderea interesului
  if intent-decay = -1 or ticks - intent-decay >= 3 [
    set adoption-intent adoption-intent * 0.97
  ]
]
      ;;NOVELTY ------
let global-adoption-share count turtles with [state = "adopted"] / count turtles
;; decay exponential — bonusul scade gradual cu timpul de cand agentul e aware
;; dupa 5 tickuri e aproape 0, dar nu dispare brusc
let time-since-aware ticks - aware-time
let novelty-bonus 0.05 * novelty-sensitivity * (1 - global-adoption-share)
      * (e ^ (- 0.4 * time-since-aware))


let intent-change 0





let price-penalty price-sensitivity * product-price
let risk-penalty risk-aversion * (1 - social-share)

set intent-change intent-change + 0.16 * peer-effect * social-share
set intent-change intent-change + novelty-bonus

if use-influencers? [
  set intent-change intent-change + 0.10 * influencer-effect * influencer-share
]

;; network externalities
set intent-change intent-change + 0.04 * global-adoption-share 

;; predispozitie individuala
set intent-change intent-change + 0.08 * susceptibility

;; bariere individuale
set intent-change intent-change - 0.03 * threshold
set intent-change intent-change - 0.10 * price-penalty
set intent-change intent-change - 0.07 * risk-penalty

;; efect de retea locala
set intent-change intent-change + 0.03 * transitivity-bonus

if social-share = 0 and influencer-share = 0 [
  set intent-change intent-change - 0.04
]

set adoption-intent adoption-intent + intent-change
set adoption-intent max (list 0 min (list 1 adoption-intent))


      if adoption-intent > threshold [
let p-adopt 0.1 + 0.5 * adoption-intent
    set p-adopt min (list 1 p-adopt)
  if random-float 1 < p-adopt [
    set state "adopted"
          ask (turtle-set consumer-link-neighbors in-influence-link-neighbors) [
  set intent-decay ticks
]


  ifelse social-share = 0 and influencer-share = 0 [
  set adoption-source "external"
][
  ifelse abs (social-share - influencer-share) < 0.1 [
    set adoption-source "mixed"
  ][
    ifelse social-share > influencer-share
      [ set adoption-source "peer" ]
      [ set adoption-source "influencer" ]
  ]
]
        ]
]
      ]
    ]
  ;;INFLUENCER STATES
if use-influencers? [
  ask turtles with [influencer? and not seed-influencer?] [
    let influencer-neighbors in-influence-link-neighbors
    let peer-neighbors consumer-link-neighbors

    ;; câți influenceri din rețea au adoptat deja
    let influencer-adoption-share 0
    let all-influencers turtles with [influencer?]
    if count all-influencers > 1 [
      set influencer-adoption-share
        count (all-influencers with [state = "adopted" and self != myself]) / (count all-influencers - 1)
    ]

    ;; câți followeri/vecini vorbesc despre produs
    let buzz-share 0
    if any? peer-neighbors [
      set buzz-share
        count (peer-neighbors with [state = "aware" or state = "adopted"]) / count peer-neighbors
    ]

    if state = "unaware" [
      ;; se trezesc dacă văd trend printre influenceri sau buzz în rețea
      let p-aware 0.01 + 0.25 * influencer-adoption-share + 0.10 * buzz-share

      set p-aware min (list 1 p-aware)

      if random-float 1 < p-aware [
        set state "aware"
        set aware-time ticks
        ifelse influencer-adoption-share > buzz-share
          [ set awareness-source "influencer" ]
          [ set awareness-source "peer" ]
      ]
    ]

    if state = "aware" and ticks > aware-time [
      ;; adoptă dacă trendul e suficient de puternic
      ;; nu le pasă de pret sau risc personal — e o decizie de brand/reputatie
      let p-adopt 0.02 + 0.40 * influencer-adoption-share + 0.15 * buzz-share

      ;; cu cât mai mulți influenceri au adoptat deja, cu atât e mai urgent să nu rămână în urmă
      let fomo-bonus 0
      if influencer-adoption-share > 0.3 [
        set fomo-bonus 0.10 * influencer-adoption-share
      ]

      set p-adopt min (list 1 (p-adopt + fomo-bonus))

      if random-float 1 < p-adopt [
        set state "adopted"
        set adoption-source "influencer"
        ;; adoptarea lor dă un semnal puternic vecinilor consumatori
        ask peer-neighbors [
          set intent-decay ticks
        ]
      ]
    ]
  ]
]
  let adopters-after count turtles with [state = "adopted"]
  set new-adopters-this-tick (adopters-after - adopters-before)
end


to set-initial-adopters
  ask turtles [
  set state "unaware"
  set adoption-intent 0
  set aware-time -1
  set awareness-source "none"
  set adoption-source "none"
  set seed-influencer? false
  set intent-decay -1
  ]



  let influencers turtles with [influencer?]
  let n min (list initial-adopters count influencers)

  ask n-of n influencers [
    set state "adopted"
    set seed-influencer? true
    set adoption-source "external"
  ]

  update-nodes
  reset-ticks
end

to transform-links



  ;; 2. salvăm conexiunile existente
let pairs sentence
  [list end1 end2] of consumer-links
  [list end1 end2] of influence-links

  ;; 3. ștergem toate link-urile
  ask consumer-links [ die ]
  ask influence-links [ die ]

  ;; 4. reconstruim link-urile
  foreach pairs [ pair ->
    let a item 0 pair
    let b item 1 pair

    ;; influencer -> follower (săgeată)
    if ([influencer?] of a) and (not [influencer?] of b) [
      ask a [
        create-influence-link-to b [
          set color violet
          set thickness 0.3

        ]
      ]
    ]

    ;; influencer <- follower
    if ([influencer?] of b) and (not [influencer?] of a) [
      ask b [
        create-influence-link-to a [
          set color violet
          set thickness 0.3

        ]
      ]
    ]

    ;; follower <-> follower (bidirecțional)
    if (not [influencer?] of a) and (not [influencer?] of b) [
      ask a [
        create-consumer-link-with b [
          set color gray
          set thickness 0.1

        ]
      ]
    ]

    ;; influencer <-> influencer
    if ([influencer?] of a) and ([influencer?] of b) [
      ask a [
        create-consumer-link-with b [
          set color orange
          set thickness 0.15

        ]
      ]
    ]
  ]

  resize-nodes
  update-nodes
end
to update-my-plots
  if ticks <= 100 [
    set-current-plot "Consumer States"
    set-current-plot-pen "Unaware"
    plot count turtles with [state = "unaware"]
    set-current-plot-pen "Aware"
    plot count turtles with [state = "aware"]
    set-current-plot-pen "Adopted"
    plot count turtles with [state = "adopted"]
  ]
end
to update-influence-plot
  if ticks <= 100 [
    set-current-plot "Awareness Source"
    set-current-plot-pen "influencer"
    plot count turtles with [awareness-source = "influencer"]
    set-current-plot-pen "peer"
    plot count turtles with [awareness-source = "peer"]
    set-current-plot-pen "mixed"
    plot count turtles with [awareness-source = "mixed"]
    set-current-plot-pen "external"
    plot count turtles with [awareness-source = "external"]
  ]
end


to setup-group-pens
  set-current-plot "Adoption by Group"
  clear-plot

  let colors [red blue green orange violet cyan magenta]

  let g 0
  while [g < number-of-groups] [
    create-temporary-plot-pen (word "Group " g)
    set-plot-pen-color item (g mod length colors) colors
    set g g + 1
  ]
end
to update-group-adoption-plot
  if ticks <= 100 [
  set-current-plot "Adoption by Group"

  ;; recreează pens-urile dacă lipsesc
  let g 0
  while [g < number-of-groups] [
    let pen-name (word "Group " g)
    if not plot-pen-exists? pen-name [
      setup-group-pens
      stop
    ]
    set g g + 1
  ]

  set g 0
  while [g < number-of-groups] [
    set-current-plot-pen (word "Group " g)

    let total-group count turtles with [group-id = g]

    ifelse total-group > 0 [
      plot (100 * count turtles with [group-id = g and state = "adopted"] / total-group)
    ] [
      plot 0
    ]

    set g g + 1
  ]
  ]
end
to update-adoption-source-plot
  if ticks <= 100 [
    set-current-plot "Adoption Source"
    set-current-plot-pen "Influencer"
    plot count turtles with [adoption-source = "influencer"]
    set-current-plot-pen "Peer"
    plot count turtles with [adoption-source = "peer"]
    set-current-plot-pen "Mixed"
    plot count turtles with [adoption-source = "mixed"]
    set-current-plot-pen "External"
    plot count turtles with [adoption-source = "external"]
  ]
end
to update-adoption-speed-plot
  set-current-plot "New adopters this tick"
   set-plot-y-range 0 10
  set-current-plot-pen "Adopted %"
  if ticks <= 100 [

  plot new-adopters-this-tick / count turtles * 100
]
end
to-report avg-openness-adopted
  ifelse any? turtles with [state = "adopted"]
    [report precision (mean [openness] of turtles with [state = "adopted"]) 2]
    [report 0]
end

to-report avg-openness-non-adopted
  ifelse any? turtles with [state != "adopted"]
    [report precision (mean [openness] of turtles with [state != "adopted"]) 2]
    [report 0]
end

to-report avg-price-adopted
  ifelse any? turtles with [state = "adopted"]
    [report precision (mean [price-sensitivity] of turtles with [state = "adopted"]) 2]
    [report 0]
end

to-report avg-price-non-adopted
  ifelse any? turtles with [state != "adopted"]
    [report precision (mean [price-sensitivity] of turtles with [state != "adopted"]) 2]
    [report 0]
end

to-report avg-risk-adopted
  ifelse any? turtles with [state = "adopted"]
    [report precision (mean [risk-aversion] of turtles with [state = "adopted"]) 2]
    [report 0]
end

to-report avg-risk-non-adopted
  ifelse any? turtles with [state != "adopted"]
    [report precision (mean [risk-aversion] of turtles with [state != "adopted"]) 2]
    [report 0]
end
to-report safe-group-variance
  let group-rates []
  let g 0
  while [g < number-of-groups] [
    let total-group count turtles with [group-id = g]
    if total-group > 0 [
      set group-rates lput (100 * count turtles with [group-id = g and state = "adopted"] / total-group) group-rates
    ]
    set g g + 1
  ]
  ifelse length group-rates >= 2
    [report variance group-rates]
    [report 0]
end]]></code>
  <widgets>
    <view x="210" wrappingAllowedX="true" y="10" frameRate="30.0" minPycor="-16" height="433" showTickCounter="true" patchSize="13.0" fontSize="10" wrappingAllowedY="true" width="433" tickCounterLabel="ticks" maxPycor="16" updateMode="0" maxPxcor="16" minPxcor="-16"></view>
    <slider x="6" step="0.05" y="509" max="1" width="173" display="influencer-effect" height="50" min="0" direction="Horizontal" default="0.4" variable="influencer-effect"></slider>
    <slider x="7" step="1" y="454" max="10" width="172" display="initial-adopters" height="50" min="0" direction="Horizontal" default="2.0" variable="initial-adopters"></slider>
    <plot x="648" autoPlotX="true" yMax="10.0" autoPlotY="true" y="232" xMin="0.0" height="217" legend="true" xMax="10.0" yMin="0.0" width="230" display="Consumer States">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Unaware" color="-16710398" legend="true">
        <setup></setup>
        <update></update>
      </pen>
      <pen interval="1.0" mode="0" display="Aware" color="-13345367" legend="true">
        <setup></setup>
        <update></update>
      </pen>
      <pen interval="1.0" mode="0" display="Adopted" color="-6459832" legend="true">
        <setup></setup>
        <update></update>
      </pen>
    </plot>
    <monitor x="210" precision="17" y="452" height="60" fontSize="11" width="100" display="Unaware">count turtles with [state = "unaware" and not influencer?]</monitor>
    <monitor x="315" precision="17" y="452" height="60" fontSize="11" width="100" display="Aware">count turtles with [state = "aware"]</monitor>
    <monitor x="420" precision="17" y="452" height="60" fontSize="11" width="100" display="Adopted %">100 * count turtles with [state = "adopted" and not influencer?] / count turtles with [not influencer?]</monitor>
    <slider x="1" step="1" y="316" max="10" width="172" display="number-of-groups" height="50" min="1" direction="Horizontal" default="3.0" variable="number-of-groups"></slider>
    <monitor x="7" precision="17" y="750" height="60" fontSize="11" width="105" display="Intra-group links">count (link-set consumer-links influence-links) with [[group-id] of end1 = [group-id] of end2]</monitor>
    <monitor x="7" precision="17" y="685" height="60" fontSize="11" width="105" display="Inter-group links">count (link-set consumer-links influence-links) with [[group-id] of end1 != [group-id] of end2]</monitor>
